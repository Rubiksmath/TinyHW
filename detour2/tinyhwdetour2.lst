     1                                  BITS 32
     2                                  
     3                                  IMAGE_BASE equ 0x690000
     4                                  org 0
     5                                  
     6                                  %define align(n, r) (((n+(r-1))/r)*r)
     7                                  
     8                                  ; DOS header
     9                                  DOS_HEADER:
    10 00000000 4D5A                        dw "MZ"                 ; DOS Magic number
    11 00000002 0000                        dw 0                    ; [UNUSED/FREE] Bytes on last page
    12                                  
    13                                  ; Start of PE header, with greedy earliest placement I could get to work
    14                                  PE_HEADER:
    15 00000004 5045                        dw "PE"                 ; [UNUSED/FREE] Pages in File                           ; PE signature part 1 "PE"    
    16 00000006 0000                        dw 0                    ; [UNUSED/FREE] Relocations                             ; PE signature part 2 "\0\0"
    17                                  
    18                                  ; Mandatory COFF/Image file header
    19                                  COFF_FILE_HEADER:
    20 00000008 4C01                        dw 0x14C                ; [UNUSED/FREE] Size of header (paragraphs)             ; Machine (Intel 386)
    21 0000000A 0100                        dw 1                    ; [UNUSED/FREE] Minimum memory (paragraphs?)            ; Number of sections (1)
    22                                  
    23                                  ; 2nd code fragment (execution wise)
    24                                  CODE_FRAGMENT_2:
    25 0000000C 8D41DA                      lea eax, [ecx + DATA - ENTRY_POINT];
    26                                                              ; [UNUSED/FREE] Maximum memory (paragraphs?)            ; [UNUSED/FREE] TimeDateStamp part 1 
    27                                                              ; [UNUSED/FREE] Initial stack segment value (relative) part 1
    28                                                                                                                      ; [UNUSED/FREE] TimeDateStamp part 2       
    29                                                                                                                                                                  ; Second argument to WriteFile, long pointer to buffer, which is just at RVA of DATA
    30 0000000F 50                          push eax;               ; [UNUSED/FREE] Initial stack segment value (relative) part 2
    31                                                                                                                      ; [UNUSED/FREE] TimeDateStamp part 3
    32                                                                                                                                                                  ; Push it
    33                                      
    34 00000010 8B4310                      mov eax, [ebx + 0x10];  ; [UNUSED/FREE] Initial stack pointer value (relative)  ; [UNUSED/FREE] PointerToSymbolTable part 1
    35                                                              ; [UNUSED/FREE] Checksum part 1                         ; [UNUSED/FREE] PointerToSymbolTable part 2 
    36                                                                                                                                                                  ; Calculating handle by looking into PEB idk I just copied the implementation of the kernel DLL don't ask
    37 00000013 FF701C                      push [eax + 0x1C];      ; Checksum part 2                                       ; [UNUSED/FREE] PointerToSymbolTable part 3
    38                                                              ; [UNUSED/FREE] Initial instruction pointer value       ; [UNUSED/FREE] NumberOfSymbols part 1
    39                                                                                                                                                                  ; First argument to WriteFile, the handle of the "file" or "stream" to write to
    40                                  
    41 00000016 EB38                        jmp CODE_FRAGMENT_3;    ; [UNUSED/FREE] Initial code segment value (relative)   ; [UNUSED/FREE] NumberOfSymbols part 2      ; Get outta here, no more space for instructions
    42 00000018 7000                        dw OPTIONAL_HEADER_SIZE ; [UNUSED/FREE] Address of DOS reloation table          ; SizeOfOptionalHeader
    43 0000001A 0200                        dw 2                    ; [UNUSED/FREE] Overlay number                          ; [RESTRICTED BUT MODIFIABLE] Characteristics (only need the 2nd least significant bit set)
    44                                  
    45                                  ; Mandatory image file "optional header"
    46                                  IMAGE_OPTIONAL_HEADER:
    47                                  
    48                                      ; Mandatory "optional header" standard fields
    49 0000001C 0B01                        dw 0x10B                ; [UNUSED/FREE] Reserved words list 1 (4) part 1        ; Magic number (indicates PE32)
    50                                  
    51                                  ; Initialised data store
    52                                  DATA:
    53 0000001E 48                          db "H"                  ; [UNUSED/FREE] Reserved words list 1 (4) part 2        ; [UNUSED/FREE] MajorLinkerVersion                                  ; String to print part 1
    54 0000001F 65                          db "e"                  ; [UNUSED/FREE] Reserved words list 1 (4) part 3        ; [UNUSED/FREE] MinorLinkerVersion                                  ; String to print part 2
    55 00000020 6C6C6F2C                    db "llo,"               ; [UNUSED/FREE] Reserved words list 1 (4) part 4        ; [UNUSED/FREE] Total size of code sections                         ; String to print part 3
    56 00000024 2057                        db " W"                 ; [UNUSED/FREE] OEM identifier                          ; [UNUSED/FREE] Total size of initialised data sections part 1      ; String to print part 4
    57 00000026 6F72                        db "or"                 ; [UNUSED/FREE] OEM information                         ; [UNUSED/FREE] Total size of initialised data sections part 2      ; String to print part 5
    58 00000028 6C64210A                    db `ld!\n`              ; [UNUSED/FREE] Reserved words list 2 (10) part 1       ; [UNUSED/FREE] Total size of uninitialised sections                ; String to print part 6
    59 0000002C [44000000]                  dd ENTRY_POINT          ; [UNUSED/FREE] Reserved words list 2 (10) part 2       ; RVA of entry point (can be modified in theory as this is just an RVA so the section stuff can go crazy)
    60                                  
    61                                  ; Name of DLL 1
    62                                  DLL_NAME_1:   
    63 00000030 4B45524E                    db "KERN"               ; [UNUSED/FREE] Reserved words list 2 (10) part 3       ; [UNUSED/FREE] RVA of beginning of code section when loaded        ; Name of DLL 1 from the import directory/table, with .dll omitted because it's not needed! part 1         
    64 00000034 454C3332                    db "EL32"               ; [UNUSED/FREE] Reserved words list 2 (10) part 4       ; [UNUSED/FREE] RVA of beginning of data section when loaded        ; Name of DLL 1 from the import directory/table, with .dll omitted because it's not needed! part 2 
    65                                  
    66                                      ; Mandatory Windows-specific "optional header" fields
    67 00000038 00006900                    dd IMAGE_BASE           ; [UNUSED/FREE] Reserved words list 2 (10) part 5       ; My funny preferred base of image
    68 0000003C [04000000]                  dd PE_HEADER            ; Address of beginning of PE header                     ; Alignment of sections when loaded into memory (0x04, dual purpose field)
    69                                  
    70                                  ; End of DOS header
    71                                  
    72 00000040 04000000                    dd 0x04                 ; Alignment of raw data of sections when loaded into memory (to match dual purpose field)
    73                                                              ; Listed requirements for these two fields are: 
    74                                                              ; SectionAlignment >= FileAlignment
    75                                                              ; FileAlignment must be power of 2
    76                                                              ; If SectionAlignment is < page size, then FileAlignment == SectionAlignment.
    77                                                              ; To be honest, if the loader patches something in to fix these fields when I go to overlap these stuff that would be funny.
    78                                  
    79                                  ; Entry point of execution / first code fragment (execution wise)
    80                                  ENTRY_POINT:
    81 00000044 6A00                        push 0;                 ; [UNUSED/FREE] Major operating system version          ; Fifth argument to WriteFile, long pointer to overlap status. Turns out this can be null and it works.
    82 00000046 6A00                        push 0;                 ; [UNUSED/FREE] Minor operating system version          ; Fourth last argument to WriteFile, long pointer to number of bytes written. Turns out this can be null and it works.                                          
    83 00000048 6A0E                        push 0xE;               ; [UNUSED/FREE] Major image version                     ; Third argument to WriteFile, number of bytes to write, which is just 0xE (14) (sorry, I had to drop the carriage return to make it fit, so its just \n now instead of \r\n)
    84 0000004A EBC0                        jmp CODE_FRAGMENT_2;    ; [UNUSED/FREE] Minor image version                     ; Get outta here, can't write any more instructions.
    85 0000004C 0400                        dw 4                    ; [RESTRICTED BUT MODIFIABLE] Major subsystem version (4, 5, or 6) 
    86 0000004E 0000                        dw 0                    ; [RESTRICTED BUT MODIFIABLE] Minor subsystem version (free if previous field 4)
    87                                  
    88                                  ; Code fragment 3 (execution wise)
    89                                  CODE_FRAGMENT_3:
    90                                      
    91 00000050 FF5138                      call [ecx + IMPORT_ADDRESS_TABLE - ENTRY_POINT];   
    92                                                                                  ; [UNUSED/FREE] Win32 version field part 1
    93                                                                                                                      ; Call the thing
    94 00000053 C3                          ret;                                        ; [UNUSED/FREE] Win32 version field part 2
    95                                                                                                                      ; Only effect is to adjust stack pointer (inner function that we call actually resets the stack pointer for us which is so kind)
    96                                                                                                                      ; And to pop the top of the stack into the instruction pointer
    97                                  
    98 00000054 B4000000                    dd 0xB4                 ; [RESTRICTED BUT MODIFIABLE] Size of image total when loaded into memory (seems to let me go anything F0 or higher, also don't go higher than 0x70000000)
    99                                                              ; In reality it seems that it can be whatever you want provided it's larger than perhaps size of code or something?
   100 00000058 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of headers total in the file, rounded up to a multiple of FileAlignment (seems to let me go anything < claimed image size in previous field) 
   101 0000005C 00000000                    dd 0                    ; [UNUSED/FREE] Checksum, seemingly unused
   102 00000060 0300                        dw 3                    ; Subsystem, 3 indicates Windows CUI
   103 00000062 0000                        dw 0                    ; [RESTRICTED BUT MODIFIABLE] DLL Characterstics (compiler generated 0x8500)                                                                                      
   104 00000064 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of stack reserve (don't go too big, i.e. maybe keep below 0x70000000) 
   105 00000068 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of stack commit (don't go too big, i.e. maybe keep below 0x70000000) 
   106 0000006C 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of heap reserve (don't go too big, i.e. maybe keep below 0x70000000)
   107 00000070 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of heap commit (don't go too big, i.e. maybe keep below 0x70000000)
   108 00000074 00000000                    dd 0                    ; [UNUSED/FREE] Loader flags
   109 00000078 02000000                    dd 0x2                  ; Number of entries in the data directory table, here only 2 are needed
   110                                  
   111                                      ; Optional header data directories
   112                                  
   113                                  ; Import address table
   114                                  IMPORT_ADDRESS_TABLE:
   115                                                              ; Structure and content of import address table is identical to the import lookup table until the file is bound by the loader. 
   116                                                              ; The addresses here get patched to the memory addresses of the imported symbols.
   117 0000007C 1B060080                    dd 0x8000061B           ; Ordinal of WriteFile on my machine with flag to indicate import by ordinal.
   118                                                                                                                      ; [UNUSED/FREE] Export table RVA
   119 00000080 00000000                    dd 0                    ; Null terminator entry 
   120                                                                                                                      ; [UNUSED/FREE] Export table size               
   121 00000084 [88000000]                  dd IMPORT_DIRECTORY     ; Import table RVA
   122                                  
   123                                  ; Import directory
   124                                  IMPORT_DIRECTORY:
   125                                                              ; Entry 1 (KERNEL32.DLL)
   126                                  
   127 00000088 00000000                    dd 0                    ; [UNUSED/FREE] Import table size               ; [UNUSED/FREE] RVA of import lookup table for entry 1 (place to look for data)
   128                                      ; End of PE header
   129                                  
   130                                  OPTIONAL_HEADER_SIZE equ $ - IMAGE_OPTIONAL_HEADER
   131                                  
   132                                  ; Section table
   133                                  SECTION_TABLE:
   134 0000008C 00000000                    dd 0                    ; [UNUSED/FREE] Name of first section, padded to 8 bytes part 1
   135                                                                                                                      ; Function name (loaded only uses if match fails) part 2                    ; [UNUSED/FREE] Zeroed Time/Date stamp for use as loader patches it              
   136 00000090 00000000                    dd 0                    ; [UNUSED/FREE] Name of first section, padded to 8 bytes part 2
   137                                                                                                                      ; Function name (loaded only uses if match fails) part 3                    ; [UNUSED/FREE] Forwarder chain, whatever that means                                                                                    
   138 00000094 [30000000]                  dd DLL_NAME_1           ; [RESTRICTED BUT MODIFIABLE] Virtual size of section when loaded into memory. 
   139                                                              ; If this is larger than the size of the raw data of the section, this gets zero padded.
   140                                                              ; (don't go too big, i.e. seems like the limit is 0xF10, or something.)
   141                                                                                                                      
   142 00000098 [7C000000]                  dd IMPORT_ADDRESS_TABLE ; [IN PRINCIPLE MODIFIABLE] Virtual address of section when loaded into memory, i.e. the offset from image base when loaded
   143                                                                                                                      
   144 0000009C F0000000                    dd 0xF0                 ; [RESTRICTED BUT MODIFIABLE] Size of the initialised data on disk for this section. Must be a multiple of file alignment from the optional header (wut), and this parameter is rounded, while virtual size is not.
   145                                                              ; Looks like it just has to be at least virtual size idk (It let me go as low as 0x41, and also up very high up to 0xFFFFFF0F, provided the virtualsize was not 0. When virtual size was 0, the size of this was much more limited)
   146                                                                                                                      ; RVA of a string containing the DLL name for this import
   147 000000A0 [7C]                        db IMPORT_ADDRESS_TABLE ; [IN PRINCIPLE MODIFIABLE] File pointer to the first page of the section part 1 (try to modify in conjunction with virtual address and/or entry)
   148                                                                                                                      ; RVA of import address table for entry 1 (place to write the results to) part 1               
   149 000000A1 00<rep 6Bh>             times align($ - $$, 268) - ($ - $$) db 0
   150                                                              ; [IN PRINCIPLE MODIFIABLE] File pointer to the first page of the section part 2 (try to modify in conjunction with virtual address and/or entry)
   151                                                              ; RVA of import address table for entry 1 (place to write the results to) part 2
   152                                                              ; [UNUSED/FREE] Pointer to relocations
   153                                                              ; [UNUSED/FREE] Pointer to line numbers
   154                                                              ; [UNUSED/FREE] Number of relocations
   155                                                              ; [UNUSED/FREE] Number of line numbers
   156                                                              ; [UNUSED/FREE] Section characteristics (Interesting that it lets me modify this freely?)        
   157                                                              ; Appease loader's undocumented hard floor of 268
   158                                  
   159                                  
   160                                  
   161                                  
   162                                  
   163                                  
   164                                      
   165                                  
