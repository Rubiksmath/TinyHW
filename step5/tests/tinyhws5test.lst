   221                                  ; Entry point
   222                                  ENTRY_POINT:
   223 00000238 55                          push ebp;
   224 00000239 89E5                        mov ebp, esp;
   225 0000023B 51                          push ecx;
   226 0000023C 51                          push ecx;
   227 0000023D 8B4310                      mov eax, [ebx + 0x10];
   228 00000240 8B401C                      mov eax, [eax + 0x1C];
   229 00000243 8945FC                      mov [ebp - 4], eax;
   230 00000246 6A00                        push 0;
   231 00000248 8D45F8                      lea eax, [ebp - 8];
   232 0000024B 50                          push eax;
   233 0000024C 6A0F                        push 0xF;
   234 0000024E 68[08026900]                push IMAGE_BASE + DATA;
   235 00000253 FF75FC                      push [ebp - 4];
   236 00000256 FF15[00026900]              call [IMAGE_BASE + IMPORT_ADDRESS_TABLE];
   237 0000025C C9                          leave;
   238 0000025D C3                          ret;
   239                                  
   240 0000025E CC<rep 2h>                  times align($ - $$, 16) - ($ - $$) int3;
   241                                  
   242                                  ; Import directory/table
   243                                  IMPORT_DIRECTORY:
   244                                                              ; Entry 1 (KERNEL32.DLL)
   245 00000260 [88020000]                  dd IMPORT_LOOKUP_TABLE_1; RVA of import lookup table for entry 1 (place to look for data)
   246 00000264 00000000                    dd 0                    ; Zeroed Time/Date stamp for use as loader patches it
   247 00000268 00000000                    dd 0                    ; Forwarder chain, whatever that means
   248 0000026C [9C020000]                  dd DLL_NAME_1           ; RVA of a string containing the DLL name for this import
   249 00000270 [00020000]                  dd IMPORT_ADDRESS_TABLE ; RVA of import address table for entry 1 (place to write the results to)
   250 00000274 00000000<rep 5h>            times 5 dd 0            ; No idea, some sort of padding?
   251                                  
   252                                  IMPORT_DIRECTORY_SIZE equ $ - IMPORT_DIRECTORY
   253                                  
   254                                  ; Import lookup table for the first DLL
   255                                  IMPORT_LOOKUP_TABLE_1:
   256 00000288 [90020000]                  dd HINT_NAME_TABLE      ; RVA of the hint/name table entry for this import, with MSB set to 0 to indicate import by name
   257 0000028C 00000000                    dd 0                    ; Null terminator entry
   258                                  
   259                                  ; Hint/name table
   260                                  HINT_NAME_TABLE:
   261                                                              ; Entry 1 (WriteFile)
   262 00000290 1606                        dw 0x616                ; Function ordinal (loader attempts to match this first)
   263 00000292 577269746546696C65-         db "WriteFile", 0       ; Function name (loader only uses if match fails)
   263 0000029B 00                 
   264                                  
   265                                  ; Name of DLL 1
   266                                  
   267                                  DLL_NAME_1:
   268 0000029C 4B45524E454C33322E-         db "KERNEL32.dll", 0    ; Name of DLL 1 from the import directory/table
   268 000002A5 646C6C00           
   269                                  
   270                                  MAIN_SIZE equ $ - CODE
   271                                  
   272 000002A9 00<rep 7h>              times align($ - $$, 16) - ($ - $$) db 0; Padding to end of section
   273                                  
   274                                  CODE_SIZE equ $ - CODE
   275                                  
   276                                  ; .reloc section, which is the initialised data, I think.
   277                                  INTDATA:
   278                                  
   279                                  ; Relocation table
   280                                  RELOC_TABLE:
   281 000002B0 00000000                    dd 0                    ; Page RVA
   282 000002B4 0C000000                    dd RELOC_BLOCK_SIZE     ; Block Size
   283                                  
   284 000002B8 4F32                        dw 0x324F               ; Block 1, indicates type of 32 bit field and relocation RVA of 0x24F
   285 000002BA 5832                        dw 0x3258               ; Block 2, indicates type of 32 bit field and relocation RVA of 0x258
   286                                  
   287                                  RELOC_BLOCK_SIZE equ $ - RELOC_TABLE
   288                                  
   289 000002BC 00<rep 4h>              times align ($ - $$, 16) - ($ - $$) db 0
   290                                  
   291                                  INTDATA_SIZE equ $ - INTDATA
   292                                  
   293                                  FILE_SIZE equ $ - $$
