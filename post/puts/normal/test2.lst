     1                                  BITS 32
     2                                  
     3                                  IMAGE_BASE equ 0x690000
     4                                  org 0
     5                                  
     6                                  %define align(n, r) (((n+(r-1))/r)*r)
     7                                  
     8                                  ; DOS header
     9                                  DOS_HEADER:
    10 00000000 4D5A                        dw "MZ"                 ; DOS Magic number
    11 00000002 0000                        dw 0                    ; [UNUSED/FREE] Bytes on last page
    12                                  
    13                                  ; Start of PE header
    14                                  PE_HEADER:
    15 00000004 5045                        dw "PE"                 ; [UNUSED/FREE] Pages in File                           ; PE signature part 1 "PE"    
    16 00000006 0000                        dw 0                    ; [UNUSED/FREE] Relocations                             ; PE signature part 2 "\0\0"
    17                                  
    18                                  ; Mandatory COFF/Image file header
    19                                  COFF_FILE_HEADER:
    20 00000008 4C01                        dw 0x14C                ; [UNUSED/FREE] Size of header (paragraphs)             ; Machine (Intel 386)
    21 0000000A 0100                        dw 1                    ; [UNUSED/FREE] Minimum memory (paragraphs?)            ; Number of sections (1)
    22                                  
    23                                  ; Entry point
    24                                  ENTRY_POINT:
    25 0000000C 8D4112                      lea eax, [ecx - ENTRY_POINT + DATA];
    26                                                              ; [UNUSED/FREE] Maximum memory (paragraphs?)            ; [UNUSED/FREE] TimeDateStamp part 1 
    27                                                              ; [UNUSED/FREE] Initial stack segment value (relative) part 1
    28                                                                                                                      ; [UNUSED/FREE] TimeDateStamp part 2        ; Calculate address of string to print from ecx holding entry point
    29 0000000F 50                          push eax                ; [UNUSED/FREE] Initial stack segment value (relative) part 2
    30                                                                                                                      ; [UNUSED/FREE] TimeDateStamp part 3
    31                                                                                                                                                                  ; Push address of string to print
    32 00000010 FF9188000000                call [ecx - ENTRY_POINT + IMPORT_ADDRESS_TABLE]          
    33                                                              ; [UNUSED/FREE] Initial stack pointer value (relative)  ; [UNUSED/FREE] PointerToSymbolTable part 1
    34                                                              ; [UNUSED/FREE] Checksum part 1                         ; [UNUSED/FREE] PointerToSymbolTable part 2                                                                                  
    35                                                              ; [UNUSED/FREE] Initial instruction pointer value       ; [UNUSED/FREE] NumberOfSymbols part 1      ; Call puts
    36 00000016 59                          pop ecx                 ; [UNUSED/FREE] Initial code segment value (relative) part 1
    37                                                                                                                      ; [UNUSED/FREE] NumberOfSymbols part 2      ; Fix stack
    38 00000017 C3                          ret                     ; [UNUSED/FREE] Initial code segment value (relative) part 2
    39                                                                                                                      ; [UNUSED/FREE] NumberOfSymbols part 3      ; Done
    40 00000018 7000                        dw OPTIONAL_HEADER_SIZE ; [UNUSED/FREE] Address of DOS reloation table          ; SizeOfOptionalHeader 
    41 0000001A 0200                        dw 0x2                  ; [UNUSED/FREE] Overlay number                          ; [RESTRICTED BUT MODIFIABLE] Characteristics (need second least significant bit set)
    42                                  
    43                                  ; Mandatory image file "optional header"
    44                                  IMAGE_OPTIONAL_HEADER:
    45                                      ; Mandatory "optional header" standard fields
    46 0000001C 0B01                        dw 0x10B                ; [UNUSED/FREE] Reserved words list 1 (4) part 1        ; Magic number (indicates PE32)
    47                                  
    48                                      ; Initialised data store
    49                                  DATA:
    50 0000001E 48                          db "H"                  ; [UNUSED/FREE] Reserved words list 1 (4) part 2        ; [UNUSED/FREE] MajorLinkerVersion          ; String to print, part 1
    51 0000001F 65                          db "e"                  ; [UNUSED/FREE] Reserved words list 1 (4) part 3        ; [UNUSED/FREE] MinorLinkerVersion          ; String to print, part 2
    52 00000020 6C6C6F2C                    db "llo,"               ; [UNUSED/FREE] Reserved words list 1 (4) part 4        ; [UNUSED/FREE] Total size of code sections ; String to print, part 3
    53 00000024 2057                        db " W"                 ; [UNUSED/FREE] OEM identifier                          ; [UNUSED/FREE] Total size of initialised data sections part 1      
    54                                                                                                                                                                  ; String to print part 4
    55 00000026 6F72                        db "or"                 ; [UNUSED/FREE] OEM information                         ; [UNUSED/FREE] Total size of initialised data sections part 2      
    56                                                                                                                                                                  ; String to print part 5
    57 00000028 6C6421                      db "ld!"                ; [UNUSED/FREE] Reserved words list 2 (10) part 1       ; [UNUSED/FREE] Total size of uninitialised sections part 1               
    58                                                                                                                                                                  ; String to print part 6
    59 0000002B 00                          db 0                    ; [UNUSED/FREE] Reserved words list 2 (10) part 2       ; [UNUSED/FREE] Total size of uninitialised sections part 2
    60                                                                                                                                                                  ; Null terminator for puts
    61 0000002C [0C000000]                  dd ENTRY_POINT          ; [UNUSED/FREE] Reserved words list 2 (10) part 3       ; RVA of entry point (Note: needs to be calculated carefully with respect to what is in the section headers. Address in file = RVA - VA + pointer to raw data in section header.)
    62                                  
    63                                  ; Name of DLL 1
    64                                  DLL_NAME_1:
    65 00000030 75637274                    dd "ucrt"               ; [UNUSED/FREE] Reserved words list 2 (10) part 4       ; [UNUSED/FREE] RVA of beginning of code section when loaded        
    66                                                                                                                                                                  ; Name of DLL 1 from the import directory/table, with .dll omitted because it's not needed! part 1
    67 00000034 62617365                    dd "base"               ; [UNUSED/FREE] Reserved words list 2 (10) part 5       ; [UNUSED/FREE] RVA of beginning of data section when loaded        
    68                                                                                                                                                                  ; Name of DLL 1 from the import directory/table, with .dll omitted because it's not needed! part 2
    69                                      
    70                                      ; Mandatory Windows-specific "optional header" fields
    71 00000038 00006900                    dd IMAGE_BASE           ; [UNUSED/FREE] Reserved words list 2 (10) part 6       ; My funny preferred base of image
    72 0000003C 04000000                    dd 0x4                  ; File offset of PE header                              ; Alignment of sections when loaded into memory (0x04, dual purpose field)
    73                                  
    74                                      ; End of DOS header
    75                                  
    76 00000040 04000000                    dd 0x4                  ; Alignment of raw data of sections
    77                                  
    78                                      ; Hint/name table
    79                                  HINT_NAME_TABLE:
    80                                                              ; Entry 1 (puts)
    81 00000044 0000                        dw 0                    ; [UNUSED/FREE] Major operating system version          ; [UNUSED/FREE] Function ordinal (loader attempts to match this first)
    82 00000046 7075                        db "pu"                 ; [UNUSED/FREE] Minor operating system version          ; Function name (loader only uses if match fails) part 1
    83 00000048 7473                        db "ts"                 ; [UNUSED/FREE] Major image version                     ; Function name (loader only uses if match fails) part 2
    84 0000004A 00                          db 0                    ; [UNUSED/FREE] Minor image version part 1              ; End of function name (null terminator)
    85                                  
    86 0000004B 00                          db 0                    ; [UNUSED/FREE] Minor image version part 2
    87 0000004C 0400                        dw 4                    ; [RESTRICTED BUT MODIFIABLE] Major subsystem version
    88 0000004E 0000                        dw 0                    ; [RESTRICTED BUT MODIFIABLE] Minor subsystem version, free if major version is 4
    89 00000050 00000000                    dd 0                    ; [UNUSED/FREE] Win32 version value
    90 00000054 B4000000                    dd 0xB4                 ; [RESTRICTED BUT MODIFIABLE] Size of image total when loaded into memory. Claimed that this must be a multiple of section alignment. 
    91                                                              ; In reality it seems that it can be whatever you want provided it's larger than perhaps size of code or something?
    92 00000058 00000000                    dd 0                    ; [UNUSED/FREE] Size of headers total in the file, rounded up to a multiple of FileAlignment
    93 0000005C 00000000                    dd 0                    ; [UNUSED/FREE] Checksum
    94 00000060 0300                        dw 3                    ; Subsystem, 3 indicates Windows CUI
    95 00000062 0000                        dw 0                    ; [RESTRICTED BUT MODIFIABLE] DLL Characterstics (unsure on restrictions)
    96 00000064 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of stack reserve (don't go too big)
    97 00000068 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of stack commit (don't go too big)
    98 0000006C 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of heap reserve (don't go too big)
    99 00000070 00000000                    dd 0                    ; [RESTRICTED BUT MODIFIABLE] Size of heap commit (don't go too big)
   100 00000074 00000000                    dd 0                    ; [UNUSED/FREE] Loader flags
   101 00000078 02000000                    dd 0x2                  ; Number of entries in the data directory table (2)
   102                                  
   103                                      ; Optional header data directories
   104                                  
   105 0000007C 00000000                    dd 0                    ; [UNUSED/FREE] Export table RVA
   106                                  
   107                                  ; Import directory/table
   108                                  IMPORT_DIRECTORY:
   109 00000080 00000000                    dd 0                    ; [UNUSED/FREE] Export table size                       ; [RESTRICTED BUT MODIFIABLE] RVA of import lookup table for entry 1 (needs to be either 0 or too big to fit in the file or equal to address of import address table or else it looks for it and errors)
   110 00000084 [80000000]                  dd IMPORT_DIRECTORY     ; Import table RVA                                      ; [UNUSED/FREE] Zeroed Time/Date stamp for use as loader patches it
   111 00000088 00000000                    dd 0                    ; [UNUSED/FREE] Import table size                       ; [UNUSED/FREE] Forwarder chain, whatever that means
   112                                                              
   113                                  
   114                                      ; End of PE header
   115                                  
   116                                  OPTIONAL_HEADER_SIZE equ $ - IMAGE_OPTIONAL_HEADER
   117                                  
   118                                  ; Section table
   119                                  SECTION_TABLE:
   120 0000008C [30000000]                  dd DLL_NAME_1           ; [UNUSED/FREE] Name of first section, padded to 8 bytes part 1       
   121                                                                                                                      ; RVA of a string containing the DLL name for this import
   122 00000090 [94000000]                  dd IMPORT_ADDRESS_TABLE ; [UNUSED/FREE] Name of first section, padded to 8 bytes part 2       
   123                                                                                                                      ; RVA of import address table for entry 1 (place to write the results to)
   124                                  
   125                                  IMPORT_ADDRESS_TABLE:
   126 00000094 [44000000]                  dd HINT_NAME_TABLE      ; [RESTRICTED BUT MODIFIABLE] Virtual size of section when loaded into memory (don't go too big or something)
   127                                                                                                                      ; Pad with null entry to signify end of table part 1 (0 not enforced)
   128                                                                                                                                                                  ; RVA of the entry into the hint/name table for this import
   129 00000098 00000000                    dd 0                    ; Virtual address of section when loaded into memory, i.e. the offset from image base when loaded
   130                                                                                                                      ; Pad with null entry to signify end of table part 2 (0 not enforced)
   131                                                                                                                                                                  ; Null terminator entry (enforced 0)
   132 0000009C 81000000                    dd 129                  ; [RESTRICTED BUT MODIFIABLE] Size of the initialised data on disk for this section (can't go too small)
   133                                                              ; Looks like it just has to be at least address of import address table + 1
   134                                                                                                                      ; Pad with null entry to signify end of table part 3 (0 not enforced)
   135                                  
   136 000000A0 00<rep 6Ch>             times align ($ - $$, 268) - ($ - $$) db 0;
   137                                                              ; Pad to minimum of 268 part 1                          ; File pointer to the first page of the section         
   138                                                                                                                                                                  ; Pad with null entry to signify end of table part 4 (enforced 0)
   139                                                              ; Pad to minimum of 268 part 2                          ; [UNUSED/FREE] Pointer to relocations      ; Pad with null entry to signify end of table part 5 (enforced 0)
   140                                                              ; Pad to minimum of 268 part 3                          ; [UNUSED/FREE] Pointer to line numbers
   141                                                              ; Pad to minimum of 268 part 4                          ; [UNUSED/FREE] Number of relocations
   142                                                              ; Pad to minimum of 268 part 5                          ; [UNUSED/FREE] Number of line numbers
   143                                                              ; Pad to minimum of 268 part 6                          ; [UNUSED/FREE] Section characteristics
