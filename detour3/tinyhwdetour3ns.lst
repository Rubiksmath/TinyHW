     1                                  BITS 32
     2                                  
     3                                  IMAGE_BASE equ 0x400000
     4                                  org 0
     5                                  
     6                                  %define align(n, r) (((n+(r-1))/r)*r)
     7                                  
     8                                  ; DOS header
     9                                  DOS_HEADER:
    10 00000000 4D5A                        dw "MZ"                 ; DOS Magic number
    11 00000002 52                          push edx;
    12 00000003 45                          inc ebp;
    13 00000004 C3                          ret;                    ; lol
    14 00000005 00<rep 37h>                 times 60 - ($ - DOS_HEADER) db 0;
    15 0000003C [80000000]                  dd PE_HEADER            ; Address of beginning of PE header
    16                                  
    17                                  DOS_STUB:
    18 00000040 0E                          db 0x0E                 ; x86_16 push cs
    19 00000041 1F                          db 0x1F                 ; x86_16 pop ds
    20 00000042 BA0E00                      db 0xBA, 0x0E, 0x00     ; x86_16 mov dx, 0x0E
    21 00000045 B409                        db 0xB4, 0x09           ; x86_16 mov ah, 0x09
    22 00000047 CD21                        db 0xCD, 0x21           ; x86_16 int 0x21 // This whole segment basically says print to screen the string at ds:dx until reaching a $. 
    23 00000049 B8014C                      db 0xB8, 0x01, 0x4C     ; x86_16 mov ax, 0x4C01
    24 0000004C CD21                        db 0xCD, 0x21           ; x86_16 int 0x21
    25 0000004E 546869732070726F67-         db "This program "      ; DOS stub message
    25 00000057 72616D20           
    26 0000005B 63616E6E6F74206265-         db "cannot be run "     ; DOS stub message (cont.)
    26 00000064 2072756E20         
    27 00000069 696E20444F53206D6F-         db "in DOS mode."       ; DOS stub message (cont.)
    27 00000072 64652E             
    28 00000075 0D0D0A24                    db `\r\r\n$`            ; End of DOS stub message
    29 00000079 00<rep 7h>                  times 7 db 0            ; Align to specific boundary (no idea if 8 or 16 or 32 or 64 or 128 byte boundary)
    30                                  
    31                                  ; End of DOS header
    32                                  
    33                                  
    34                                  ; Start of PE header
    35                                  PE_HEADER:
    36 00000080 50450000                    dw "PE", 0              ; PE signature "PE\0\0"
    37                                  
    38                                  ; Mandatory COFF/Image file header
    39                                  COFF_FILE_HEADER:
    40 00000084 4C01                        dw 0x14C                ; Machine (Intel 386)
    41 00000086 0000                        dw 0                    ; NumberOfSections (0)
    42 00000088 E7B03B6A                    dd 0x6A3BB0E7           ; TimeDateStamp (Wednesday, 24.06.2026 10:26:47 UTC)
    43 0000008C 00000000                    dd 0                    ; PointerToSymbolTable [0 for images]
    44 00000090 00000000                    dd 0                    ; NumberOfSymbols [0 for images]
    45 00000094 6000                        dw OPTIONAL_HEADER_SIZE ; SizeOfOptionalHeader (usually 0xE0 for this type of app cause 32 bit)
    46 00000096 0301                        dw 0x103                ; Characteristics (0x01 -> No relocation info present; 0x02 -> executable file; 0x100 -> 32 bit machine)
    47                                  
    48                                  ; Mandatory image file "optional header"
    49                                  IMAGE_OPTIONAL_HEADER:
    50                                      ; Mandatory "optional header" standard fields
    51 00000098 0B01                        dw 0x10B                ; Magic number (indicates PE32)
    52 0000009A 0E                          db 0xE                  ; MajorLinkerVersion (14)
    53 0000009B 21                          db 0x21                 ; MinorLinkerVersion (33)
    54 0000009C 00000000                    dd 0                    ; Total size of code sections (48 bytes)
    55 000000A0 00000000                    dd 0                    ; Total size of initialised data sections (0 bytes)
    56 000000A4 00000000                    dd 0                    ; Total size of uninitialised data sections (0 bytes)
    57 000000A8 00000000                    dd 0                    ; RVA of entry point (Note: needs to be calculated carefully with respect to what is in the section headers. Address in file = RVA - VA + pointer to raw data in section header.)
    58 000000AC 00000000                    dd 0                    ; RVA of beginning of code section when loaded
    59 000000B0 00020000                    dd 0x200                ; RVA of beginning of data section when loaded
    60                                  
    61                                      ; Mandatory Windows-specific "optional header" fields
    62                                  
    63 000000B4 00004000                    dd IMAGE_BASE           ; My funny preferred base of image
    64 000000B8 00080000                    dd 0x800                  ; Alignment of sections when loaded into memory
    65 000000BC 00080000                    dd 0x800                  ; Alignment of raw data of sections in image file (honestly not sure on the difference)
    66                                                              ; Listed requirements for these two fields are: SectionAlignment >= FileAlignment, FileAlignment must be power of 2, and if SectionAlignment is < page size, then FileAlignment == SectionAlignment.
    67                                                              ; To be honest, if the loader patches something in to fix these fields when I go to overlap these stuff that would be funny.
    68 000000C0 0600                        dw 6                    ; Major operating system version (indicates Windows Vista/Server 2008)
    69 000000C2 0000                        dw 0                    ; Minor operating system version
    70 000000C4 0000                        dw 0                    ; Major image version
    71 000000C6 0000                        dw 0                    ; Minor image version
    72 000000C8 0600                        dw 6                    ; Major subsystem version
    73 000000CA 0000                        dw 0                    ; Minor subsystem version
    74 000000CC 00000000                    dd 0                    ; Reserved field for Win32 version value, though it is claimed this must be 0.
    75 000000D0 90010000                    dd FILE_SIZE            ; Size of image total when loaded into memory. Claimed that this must be a multiple of section alignment. 
    76                                                              ; In reality it seems that it can be whatever you want provided it's larger than perhaps size of code or something?
    77 000000D4 F8000000                    dd HEADER_SIZE          ; Size of headers total in the file, rounded up to a multiple of FileAlignment
    78 000000D8 00000000                    dd 0                    ; Checksum, seemingly unused
    79 000000DC 0300                        dw 3                    ; Subsystem, 3 indicates Windows CUI
    80 000000DE 0085                        dw 0x8500               ; DLL Characterstics, (0x8000 -> TerminalServer aware, 0x400 -> Image does not use SEH, 0x100 -> Image is NX compatible)
    81 000000E0 00001000                    dd 0x100000             ; Size of stack reserve, some sort of something idk
    82 000000E4 00100000                    dd 0x1000               ; Size of stack commit
    83 000000E8 00001000                    dd 0x100000             ; Size of heap reserve
    84 000000EC 00100000                    dd 0x1000               ; Size of heap commit
    85 000000F0 00000000                    dd 0                    ; Loader flags, apparently must be 0
    86 000000F4 00000000                    dd 0                    ; Number of entries in the data directory table, of which there are none here.
    87                                  
    88                                      ; Optional header data directories (empty)
    89                                  
    90                                      ; End of PE header
    91                                  
    92                                  OPTIONAL_HEADER_SIZE equ $ - IMAGE_OPTIONAL_HEADER
    93                                  HEADER_SIZE equ $ - $$
    94                                  
    95                                  
    96 000000F8 00<rep 94h>             times align($ - PE_HEADER, 268) - ($ - PE_HEADER) db 0
    97                                                              ; Padding to hit the minimum 
    98 0000018C 00<rep 4h>              times align($ - $$, 16) - ($ - $$) db 0
    99                                                              ; Pad to 16 byte boundary cause I'm nice.
   100                                  FILE_SIZE equ $ - $$
