     1                                  BITS 32
     2                                  
     3                                  IMAGE_BASE equ 0x400000
     4                                  org 0
     5                                  
     6                                  %define align(n, r) (((n+(r-1))/r)*r)
     7                                  
     8                                  ; DOS header
     9                                  DOS_HEADER:
    10 00000000 4D5A                        dw "MZ"                 ; DOS Magic number
    11 00000002 9000                        dw 0x90                 ; Bytes on last page
    12 00000004 0300                        dw 0x03                 ; Pages in File
    13 00000006 0000                        dw 0                    ; Relocations
    14 00000008 0400                        dw 0x04                 ; Size of header (paragraphs)
    15 0000000A 0000                        dw 0                    ; Minimum memory (paragraphs?)
    16 0000000C FFFF                        dw 0xFFFF               ; Maximum memory (paragraphs?)
    17 0000000E 0000                        dw 0                    ; Initial stack segment value (relative)
    18 00000010 B800                        dw 0xB8                 ; Initial stack pointer value
    19 00000012 0000                        dw 0                    ; Checksum
    20 00000014 0000                        dw 0                    ; Initial instruction pointer value
    21 00000016 0000                        dw 0                    ; Initial code segment value (relative)
    22 00000018 4000                        dw 0x40                 ; Address of DOS reloation table
    23 0000001A 0000                        dw 0                    ; Overlay number
    24 0000001C 0000<rep 4h>                times 4 dw 0            ; Reserved words (4)
    25 00000024 0000                        dw 0                    ; OEM identifier
    26 00000026 0000                        dw 0                    ; OEM information
    27 00000028 0000<rep Ah>                times 10 dw 0           ; Reserved words part 2 (10)
    28 0000003C [80000000]                  dd PE_HEADER            ; Address of beginning of PE header
    29                                  
    30                                  DOS_STUB:
    31 00000040 0E                          db 0x0E                 ; x86_16 push cs
    32 00000041 1F                          db 0x1F                 ; x86_16 pop ds
    33 00000042 BA0E00                      db 0xBA, 0x0E, 0x00     ; x86_16 mov dx, 0x0E
    34 00000045 B409                        db 0xB4, 0x09           ; x86_16 mov ah, 0x09
    35 00000047 CD21                        db 0xCD, 0x21           ; x86_16 int 0x21 // This whole segment basically says print to screen the string at ds:dx until reaching a $. 
    36 00000049 B8014C                      db 0xB8, 0x01, 0x4C     ; x86_16 mov ax, 0x4C01
    37 0000004C CD21                        db 0xCD, 0x21           ; x86_16 int 0x21
    38 0000004E 546869732070726F67-         db "This program "      ; DOS stub message
    38 00000057 72616D20           
    39 0000005B 63616E6E6F74206265-         db "cannot be run "     ; DOS stub message (cont.)
    39 00000064 2072756E20         
    40 00000069 696E20444F53206D6F-         db "in DOS mode."       ; DOS stub message (cont.)
    40 00000072 64652E             
    41 00000075 0D0D0A24                    db `\r\r\n$`            ; End of DOS stub message
    42 00000079 00<rep 7h>                  times 7 db 0            ; Align to specific boundary (no idea if 8 or 16 or 32 or 64 or 128 byte boundary)
    43                                  
    44                                  ; End of DOS header
    45                                  
    46                                  
    47                                  ; Start of PE header
    48                                  PE_HEADER:
    49 00000080 50450000                    dw "PE", 0              ; PE signature "PE\0\0"
    50                                  
    51                                  ; Mandatory COFF/Image file header
    52                                  COFF_FILE_HEADER:
    53 00000084 4C01                        dw 0x14C                ; Machine (Intel 386)
    54 00000086 0100                        dw 1                    ; NumberOfSections (1)
    55 00000088 E7B03B6A                    dd 0x6A3BB0E7           ; TimeDateStamp (Wednesday, 24.06.2026 10:26:47 UTC)
    56 0000008C 00000000                    dd 0                    ; PointerToSymbolTable [0 for images]
    57 00000090 00000000                    dd 0                    ; NumberOfSymbols [0 for images]
    58 00000094 6000                        dw OPTIONAL_HEADER_SIZE ; SizeOfOptionalHeader (usually 0xE0 for this type of app cause 32 bit)
    59 00000096 0301                        dw 0x103                ; Characteristics (0x01 -> No relocation info present; 0x02 -> executable file; 0x100 -> 32 bit machine)
    60                                  
    61                                  ; Mandatory image file "optional header"
    62                                  IMAGE_OPTIONAL_HEADER:
    63                                      ; Mandatory "optional header" standard fields
    64 00000098 0B01                        dw 0x10B                ; Magic number (indicates PE32)
    65 0000009A 0E                          db 0xE                  ; MajorLinkerVersion (14)
    66 0000009B 21                          db 0x21                 ; MinorLinkerVersion (33)
    67 0000009C 6C000000                    dd CODE_SIZE            ; Total size of code sections (48 bytes)
    68 000000A0 00000000                    dd 0                    ; Total size of initialised data sections (0 bytes)
    69 000000A4 00000000                    dd 0                    ; Total size of uninitialised data sections (0 bytes)
    70 000000A8 [20010000]                  dd ENTRY_POINT          ; RVA of entry point (Note: needs to be calculated carefully with respect to what is in the section headers. Address in file = RVA - VA + pointer to raw data in section header.)
    71 000000AC [20010000]                  dd CODE                 ; RVA of beginning of code section when loaded
    72 000000B0 00020000                    dd 0x200                ; RVA of beginning of data section when loaded
    73                                  
    74                                      ; Mandatory Windows-specific "optional header" fields
    75                                  
    76 000000B4 00004000                    dd IMAGE_BASE           ; My funny preferred base of image
    77 000000B8 00080000                    dd 0x800                  ; Alignment of sections when loaded into memory
    78 000000BC 00080000                    dd 0x800                  ; Alignment of raw data of sections in image file (honestly not sure on the difference)
    79                                                              ; Listed requirements for these two fields are: SectionAlignment >= FileAlignment, FileAlignment must be power of 2, and if SectionAlignment is < page size, then FileAlignment == SectionAlignment.
    80                                                              ; To be honest, if the loader patches something in to fix these fields when I go to overlap these stuff that would be funny.
    81 000000C0 0600                        dw 6                    ; Major operating system version (indicates Windows Vista/Server 2008)
    82 000000C2 0000                        dw 0                    ; Minor operating system version
    83 000000C4 0000                        dw 0                    ; Major image version
    84 000000C6 0000                        dw 0                    ; Minor image version
    85 000000C8 0600                        dw 6                    ; Major subsystem version
    86 000000CA 0000                        dw 0                    ; Minor subsystem version
    87 000000CC 00000000                    dd 0                    ; Reserved field for Win32 version value, though it is claimed this must be 0.
    88 000000D0 90010000                    dd FILE_SIZE            ; Size of image total when loaded into memory. Claimed that this must be a multiple of section alignment. 
    89                                                              ; In reality it seems that it can be whatever you want provided it's larger than perhaps size of code or something?
    90 000000D4 20010000                    dd HEADER_SIZE          ; Size of headers total in the file, rounded up to a multiple of FileAlignment
    91 000000D8 00000000                    dd 0                    ; Checksum, seemingly unused
    92 000000DC 0300                        dw 3                    ; Subsystem, 3 indicates Windows CUI
    93 000000DE 0085                        dw 0x8500               ; DLL Characterstics, (0x8000 -> TerminalServer aware, 0x400 -> Image does not use SEH, 0x100 -> Image is NX compatible)
    94 000000E0 00001000                    dd 0x100000             ; Size of stack reserve, some sort of something idk
    95 000000E4 00100000                    dd 0x1000               ; Size of stack commit
    96 000000E8 00001000                    dd 0x100000             ; Size of heap reserve
    97 000000EC 00100000                    dd 0x1000               ; Size of heap commit
    98 000000F0 00000000                    dd 0                    ; Loader flags, apparently must be 0
    99 000000F4 00000000                    dd 0                    ; Number of entries in the data directory table, of which there are none here.
   100                                  
   101                                      ; Optional header data directories (empty)
   102                                  
   103                                      ; End of PE header
   104                                  
   105                                  OPTIONAL_HEADER_SIZE equ $ - IMAGE_OPTIONAL_HEADER
   106                                  
   107                                  ; Section table
   108                                  SECTION_TABLE:
   109 000000F8 2E00000000000000            db ".", 0, 0, 0, 0, 0, 0, 0
   110                                                              ; Name of first section, padded to 8 bytes (".")
   111 00000100 03000000                    dd MAIN_SIZE            ; Virtual size of section when loaded into memory. If this is larger than the size of the raw data of the section, this gets zero padded.
   112 00000104 [20010000]                  dd CODE                 ; Virtual address of section when loaded into memory, i.e. the offset from image base when loaded
   113 00000108 6C000000                    dd CODE_SIZE            ; Size of the initialised data on disk for this section. Must be a multiple of file alignment from the optional header (wut), and this parameter is rounded, while virtual size is not.
   114                                                              ; Looks like it just has to be at least virtual size idk
   115 0000010C [20010000]                  dd CODE                 ; File pointer to the first page of the section
   116 00000110 00000000                    dd 0                    ; Pointer to relocations
   117 00000114 00000000                    dd 0                    ; Pointer to line numbers
   118 00000118 0000                        dw 0                    ; Number of relocations
   119 0000011A 0000                        dw 0                    ; Number of line numbers
   120 0000011C 20000060                    dd 0x60000020           ; Section characteristics (0x20 -> contains executable code; 0x20000000 -> can be executed as code; 0x40000000 -> can be read)
   121                                  
   122                                  HEADER_SIZE equ $ - $$
   123                                  
   124                                  ; Start of code
   125                                  CODE:
   126                                  
   127                                  ; Entry point
   128                                  ENTRY_POINT:
   129 00000120 C20000                      ret 0;
   130                                  
   131                                  MAIN_SIZE equ $ - CODE
   132                                  
   133 00000123 00<rep 69h>             times align($ - PE_HEADER, 268) - ($ - PE_HEADER) db 0; Padding to hit the minimum 
   134                                  
   135                                  CODE_SIZE equ $ - CODE
   136 0000018C 00<rep 4h>              times align($ - $$, 16) - ($ - $$) db 0; Pad to boundary cause I'm nice.
   137                                  FILE_SIZE equ $ - $$
